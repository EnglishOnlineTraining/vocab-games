{
  "extraKnownMarketplaces": {
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  },
  "enabledPlugins": {
    "html-plan@claude-community": true
  },
  "permissions": {
    "allow": [
      "Bash(node scripts/build.js)",
      "Bash(node scripts/build.js --check)",
      "Bash(node scripts/build.js --explain)",
      "Bash(node scripts/verify-exercise.js:*)",
      "Bash(node scripts/validate-explanations.js)",
      "Bash(node test-*.js)",
      "Bash(npm test)",
      "Bash(npm run check)",
      "Bash(npx playwright test:*)",
      "Bash(node scripts/test-wp-trap-guard.js)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__wpcom-(mcp-pages-update|mcp-posts-update|content-items-update|page-sections-.*|post-sections-.*)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/wp-trap-guard.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
