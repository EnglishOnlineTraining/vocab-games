{
  "extraKnownMarketplaces": {
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  },
  "enabledPlugins": {
    "html-plan@claude-community": true
  },
  "permissions": {
    "allow": [
      "Bash(node scripts/build.js)",
      "Bash(node scripts/build.js --check)",
